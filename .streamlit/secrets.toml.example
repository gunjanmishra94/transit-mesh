# Copy the relevant lines into Streamlit Community Cloud's app settings ->
# Secrets editor (not into a committed secrets.toml, that file is
# gitignored on purpose). Local `make app` runs against the local DuckDB
# file by default and doesn't need this at all.

DUCKDB_PATH = "md:transit_mesh"
MOTHERDUCK_TOKEN = "paste-your-motherduck-token-here"
motherduck_token = "paste-your-motherduck-token-here"
