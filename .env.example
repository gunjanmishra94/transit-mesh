# DUCKDB_PATH must be an ABSOLUTE path, not relative. `make setup` generates
# `.env` with the correct absolute path automatically — this file is just a
# reference if you're creating .env by hand.
#
# Why absolute: Dagster's CLI (`dagster dev`, `dagster job execute`)
# auto-loads .env from its invocation directory for the whole process, and
# the dbt subprocess it spawns runs with cwd=dbt_transit/ — so a relative
# value resolves against the wrong directory depending on which of those
# two contexts reads it.
DUCKDB_PATH=/absolute/path/to/transit-mesh/duckdb_data/transit.duckdb
